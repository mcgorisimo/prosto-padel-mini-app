# Synthetic local-only values. Do not put real credentials here.
TEST_NODE_IMAGE=node:20.11.0-bookworm-slim
TEST_POSTGRES_IMAGE=postgres:14-bookworm
TEST_NGINX_IMAGE=nginx:1.27.4-alpine
TEST_POSTGRES_DB=prosto_padel_test_migration_cycle
TEST_POSTGRES_USER=prosto_padel_test
TEST_POSTGRES_PASSWORD=local_test_password_only
EXPECTED_TEST_DATABASE_HOST=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=prosto_padel_test_migration_cycle
DATABASE_USER=prosto_padel_test

# Public frontend build-time feature flag; this is not a secret.
VITE_TELEGRAM_BACKEND_LOGIN_ENABLED=false

# Runtime backend override: paths only, never secret contents.
BACKEND_AUTH_APP_PASSWORD_FILE_HOST=/absolute/path/outside/repository/backend-auth-app-password
TELEGRAM_BOT_TOKEN_FILE_HOST=/absolute/path/outside/repository/telegram-bot-token
TELEGRAM_IDENTITY_LOOKUP_PEPPER_BASE64_FILE_HOST=/absolute/path/outside/repository/telegram-identity-lookup-pepper-base64
TELEGRAM_LOGIN_WORKFLOW_HMAC_SECRET_BASE64_FILE_HOST=/absolute/path/outside/repository/telegram-login-workflow-hmac-secret-base64
PROFILE_PHOTO_STORAGE_ACCESS_KEY_ID_FILE_HOST=/absolute/path/outside/repository/profile-photo-access-key-id
PROFILE_PHOTO_STORAGE_SECRET_ACCESS_KEY_FILE_HOST=/absolute/path/outside/repository/profile-photo-secret-access-key
TELEGRAM_AUTH_ENABLED=false
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=
TELEGRAM_LOGIN_UUID_NAMESPACE=
TELEGRAM_OUTBOUND_NOTIFICATIONS_ENABLED=false
TELEGRAM_MINI_APP_URL=https://app.prostopdl.ru/

# Profile photo storage remains disabled until the bucket policy, mounted
# credentials, and public object URL have all passed the rollout checks.
PROFILE_PHOTO_STORAGE_ENABLED=false
PROFILE_PHOTO_STORAGE_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
PROFILE_PHOTO_STORAGE_REGION=ru-7
PROFILE_PHOTO_STORAGE_BUCKET=prosto-padel-test-profile-photos
PROFILE_PHOTO_PUBLIC_BASE_URL=https://example.selstorage.ru
