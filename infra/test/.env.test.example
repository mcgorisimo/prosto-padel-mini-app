# Synthetic local-only values. Do not put real credentials here.
# Runtime rollout must replace this with the exact lowercase 40-character
# commit SHA. Leaving it empty makes runtime Compose validation fail closed.
APP_RELEASE=
TEST_NODE_IMAGE=node:20.11.0-bookworm-slim
TEST_POSTGRES_IMAGE=postgres:14-bookworm
TEST_NGINX_IMAGE=nginx:1.27.4-alpine
TEST_LOKI_IMAGE=grafana/loki:3.7.4
TEST_VECTOR_IMAGE=timberio/vector:0.56.0-alpine
TEST_PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
TEST_ALERTMANAGER_IMAGE=prom/alertmanager:v0.32.1
TEST_NODE_EXPORTER_IMAGE=prom/node-exporter:v1.11.1
TEST_GRAFANA_IMAGE=grafana/grafana:13.1.0
TEST_POSTGRES_DB=prosto_padel_test_migration_cycle
TEST_POSTGRES_USER=prosto_padel_test
TEST_POSTGRES_PASSWORD=local_test_password_only
EXPECTED_TEST_DATABASE_HOST=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=prosto_padel_test_migration_cycle
DATABASE_USER=prosto_padel_test

# Public frontend build-time feature flag; this is not a secret.
VITE_TELEGRAM_BACKEND_LOGIN_ENABLED=false

# Public onboarding build settings for the immutable 26.08.2026 documents on
# Selectel test. Enabling them is a separate rollout/env gate.
VITE_ONBOARDING_LEGAL_PUBLISHED=false
VITE_ONBOARDING_LEGAL_POLICY_ALIGNED=false
VITE_ONBOARDING_LEGAL_TEST_ONLY=false
VITE_ONBOARDING_TERMS_URL=https://test-app.prostopdl.ru/legal/terms/terms-2026-08-26-v1/
VITE_ONBOARDING_TERMS_VERSION=terms-2026-08-26-v1
VITE_ONBOARDING_PRIVACY_URL=https://test-app.prostopdl.ru/legal/privacy/privacy-2026-08-26-v1/
VITE_ONBOARDING_PRIVACY_VERSION=privacy-2026-08-26-v1
VITE_ONBOARDING_CANCELLATION_URL=https://test-app.prostopdl.ru/legal/cancellation/cancellation-2026-08-26-v1/
VITE_ONBOARDING_CANCELLATION_VERSION=cancellation-2026-08-26-v1
VITE_ONBOARDING_PERSONAL_DATA_CONSENT_URL=https://test-app.prostopdl.ru/legal/personal-data-consent/personal-data-consent-2026-08-26-v1/
VITE_ONBOARDING_PERSONAL_DATA_CONSENT_VERSION=personal-data-consent-2026-08-26-v1

# Backend legal policy remains fail-closed until the separately approved test
# env/rollout gate enables these exact versions together with the frontend.
PLAYER_ONBOARDING_LEGAL_POLICY_ENABLED=false
PLAYER_ONBOARDING_TERMS_VERSION=terms-2026-08-26-v1
PLAYER_ONBOARDING_PRIVACY_VERSION=privacy-2026-08-26-v1
PLAYER_ONBOARDING_CANCELLATION_VERSION=cancellation-2026-08-26-v1
PLAYER_ONBOARDING_PERSONAL_DATA_PROCESSING_VERSION=personal-data-consent-2026-08-26-v1

# Runtime backend override: paths only, never secret contents.
BACKEND_AUTH_APP_PASSWORD_FILE_HOST=/absolute/path/outside/repository/backend-auth-app-password
TELEGRAM_BOT_TOKEN_FILE_HOST=/absolute/path/outside/repository/telegram-bot-token
TELEGRAM_IDENTITY_LOOKUP_PEPPER_BASE64_FILE_HOST=/absolute/path/outside/repository/telegram-identity-lookup-pepper-base64
TELEGRAM_LOGIN_WORKFLOW_HMAC_SECRET_BASE64_FILE_HOST=/absolute/path/outside/repository/telegram-login-workflow-hmac-secret-base64
PROFILE_PHOTO_STORAGE_ACCESS_KEY_ID_FILE_HOST=/absolute/path/outside/repository/profile-photo-access-key-id
PROFILE_PHOTO_STORAGE_SECRET_ACCESS_KEY_FILE_HOST=/absolute/path/outside/repository/profile-photo-secret-access-key
TELEGRAM_AUTH_ENABLED=false
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=
TELEGRAM_LOGIN_UUID_NAMESPACE=
TELEGRAM_OUTBOUND_NOTIFICATIONS_ENABLED=false
TELEGRAM_MINI_APP_URL=https://app.prostopdl.ru/

# YCLIENTS webhook intake remains disabled until migration 032, the disabled
# boundary smoke test, and the exact non-secret company ID have been verified.
YCLIENTS_WEBHOOK_ENABLED=false
YCLIENTS_COMPANY_ID=
YCLIENTS_API_ENABLED=false
YCLIENTS_BOOKING_WRITE_ENABLED=false
YCLIENTS_NOTIFICATION_READ_RECONCILIATION_ENABLED=false
YCLIENTS_API_BASE_URL=https://api.yclients.com
YCLIENTS_PARTNER_TOKEN_FILE_HOST=/absolute/path/outside/repository/yclients-partner-token
YCLIENTS_USER_TOKEN_FILE_HOST=/absolute/path/outside/repository/yclients-user-token
RESERVATION_SNAPSHOT_MASTER_KEY_BASE64_FILE_HOST=/absolute/path/outside/repository/reservation-snapshot-master-key-base64
RESERVATION_SNAPSHOT_KEY_VERSION=1

# Grafana is published only on server loopback. The password file is required
# by the persistent runtime override and must stay outside the repository.
GRAFANA_ADMIN_USER=observability_admin
GRAFANA_ADMIN_PASSWORD_FILE_HOST=/absolute/path/outside/repository/grafana-admin-password

# Profile photo storage remains disabled until the bucket policy, mounted
# credentials, and public object URL have all passed the rollout checks.
PROFILE_PHOTO_STORAGE_ENABLED=false
PROFILE_PHOTO_STORAGE_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
PROFILE_PHOTO_STORAGE_REGION=ru-7
PROFILE_PHOTO_STORAGE_BUCKET=prosto-padel-test-profile-photos
PROFILE_PHOTO_PUBLIC_BASE_URL=https://example.selstorage.ru
