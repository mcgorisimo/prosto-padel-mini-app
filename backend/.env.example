HOST=127.0.0.1
PORT=3000
CRM_PROVIDER=disabled
DATABASE_ENABLED=false
DATABASE_URL=

# Alternative database component mode. Remove DATABASE_URL entirely before
# enabling these values; direct URL and component mode are mutually exclusive.
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_NAME=prosto_padel_test_migration_cycle
# DATABASE_USER=backend_auth_app
# DATABASE_PASSWORD_FILE=/run/secrets/backend_auth_app_password

# Telegram authentication remains disabled by default. Direct secret values
# are retained for local/test compatibility. For a mounted-file secret, remove
# the corresponding direct key entirely; setting both, even with an empty
# direct value, is rejected.
TELEGRAM_AUTH_ENABLED=false
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=
TELEGRAM_IDENTITY_LOOKUP_PEPPER_BASE64=
# TELEGRAM_IDENTITY_LOOKUP_PEPPER_BASE64_FILE=/run/secrets/telegram_lookup_pepper
TELEGRAM_LOGIN_WORKFLOW_HMAC_SECRET_BASE64=
# TELEGRAM_LOGIN_WORKFLOW_HMAC_SECRET_BASE64_FILE=/run/secrets/telegram_workflow_hmac
TELEGRAM_LOGIN_UUID_NAMESPACE=
